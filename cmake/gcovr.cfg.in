root = @CMAKE_SOURCE_DIR@
cobertura = @CMAKE_BINARY_DIR@/coverage/cobertura.xml
sonarqube = @CMAKE_BINARY_DIR@/coverage/sonarqube.xml
html-details = @CMAKE_BINARY_DIR@/coverage/coverage.html
gcov-executable = @GCOV_EXECUTABLE@
gcov-parallel = yes
html-theme = github.dark-blue
html-self-contained = yes
print-summary = yes
filter = .*/include/beman/movable_box/.*
# Relative to this file (the build dir): skip fetched dependencies such as Catch2.
exclude-directory = _deps$
coveralls = coverage.json
coveralls-pretty = yes
